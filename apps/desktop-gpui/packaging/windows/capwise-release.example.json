{
	"productName": "Capwise",
	"mainBinaryName": "Capwise",
	"identifier": "com.capwise.app",
	"plugins": {
		"deep-link": null,
		"updater": {
			"endpoints": [
				"https://updates.example.com/capwise/latest.json"
			],
			"pubkey": "REPLACE_WITH_YOUR_MINISIGN_PUBLIC_KEY"
		}
	},
	"bundle": {
		"createUpdaterArtifacts": true,
		"fileAssociations": [
			{
				"ext": ["cap"],
				"name": "Capwise Project",
				"mimeType": "application/x-cap-project",
				"role": "Editor"
			}
		],
		"windows": {
			"nsis": {
				"installMode": "currentUser"
			}
		}
	}
}
